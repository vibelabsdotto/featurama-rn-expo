{
  "name": "@vibelabsdotto/featurama-rn-expo",
  "version": "0.1.0",
  "description": "Featurama SDK for React Native and Expo",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js"
    },
    "./expo-router": {
      "types": "./lib/typescript/expo-router.d.ts",
      "react-native": "./src/expo-router.tsx",
      "import": "./lib/module/expo-router.js",
      "require": "./lib/commonjs/expo-router.js"
    }
  },
  "files": ["src", "lib", "ios", "android", "*.podspec", "react-native.config.js", "LICENSE", "README.md", "!**/__tests__", "!**/__fixtures__", "!**/__mocks__"],
  "scripts": {
    "prepare": "bob build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["react-native", "expo", "feature-requests", "featurama", "sdk"],
  "repository": {"type": "git", "url": "https://github.com/vibelabsdotto/featurama-rn-expo.git"},
  "author": "VibeLabs",
  "license": "MIT",
  "bugs": {"url": "https://github.com/vibelabsdotto/featurama-rn-expo/issues"},
  "homepage": "https://github.com/vibelabsdotto/featurama-rn-expo#readme",
  "publishConfig": {"access": "public"},
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.17.0",
    "expo-localization": ">=14.0.0",
    "expo-router": ">=5.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.74.0",
    "react-native-localize": ">=3.0.0",
    "react-native-svg": ">=13.0.0"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": {"optional": false},
    "expo-localization": {"optional": true},
    "expo-router": {"optional": true},
    "react-native-localize": {"optional": true},
    "react-native-svg": {"optional": false}
  },
  "devDependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@types/react": "~19.1.0",
    "expo-router": "~6.0.15",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-builder-bob": "^0.23.0",
    "react-native-svg": "^15.15.0",
    "typescript": "~5.9.2"
  },
  "codegenConfig": {
    "name": "FeaturamaInsetsSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {"javaPackageName": "com.featurama.reactnative"}
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": ["commonjs", "module", ["typescript", {"project": "tsconfig.build.json"}]]
  }
}
